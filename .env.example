# --- Backend ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/automatedcv
JWT_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:5173

# LLM provider: groq | gemini | openrouter | fake
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Embeddings: gemini | fake
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001

# Cloudflare Turnstile (these are Cloudflare's always-pass test keys)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Limits
DAILY_LLM_RUNS_PER_USER=20

# Observability (optional)
SENTRY_DSN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
