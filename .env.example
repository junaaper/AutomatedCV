# Copy the backend section to backend/.env and the frontend section to frontend/.env.
# Everything has a working local default; only the API keys are needed for live AI runs.

# --- Backend (backend/.env) ---
# postgres://, postgresql:// and postgresql+psycopg:// are all accepted.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automatedcv
# Used by pytest (tables are truncated between tests, so keep it separate from dev).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automatedcv_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:5173
# Production only: the frontend proxies /api/* to the backend.
# COOKIE_PATH_PREFIX=/api

# LLM provider: groq | gemini | openrouter | fake (offline, no key needed)
LLM_PROVIDER=groq
# Free models change; list current ones with GET https://api.groq.com/openai/v1/models
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Embeddings: gemini | fake (offline, no key needed)
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001

# Cloudflare Turnstile (this is Cloudflare's always-pass test secret)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Limits on live LLM runs per UTC day
DAILY_LLM_RUNS_PER_USER=20
DEMO_DAILY_LLM_RUNS=3
GLOBAL_DAILY_LLM_RUNS=500

# Observability (optional)
SENTRY_DSN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=automatedcv

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:8000
# Cloudflare's always-pass test site key
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_SENTRY_DSN=
